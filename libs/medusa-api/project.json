{
  "name": "medusa-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/medusa-api/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/medusa-api",
        "main": "libs/medusa-api/src/index.ts",
        "tsConfig": "libs/medusa-api/tsconfig.lib.json",
        "assets": [
          "libs/medusa-api/*.md"
        ]
      }
    },
    "generate-types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "medusa types generate --output libs/medusa-api/src/types/medusa-types.ts"
      }
    },
    "generate-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @openapitools/openapi-generator-cli generate -i http://localhost:9000/openapi/store -g typescript-angular -o libs/medusa-api/src/lib/generated --additional-properties=providedInRoot=true,strictPropertyInitialization=false"
      }
    }
  }
}
