{
  "name": "@open-b2b/source",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nx run-many --targets=serve --projects=storefront,backend --parallel=2 --verbose",
    "backend": "nx serve backend --verbose",
    "storefront": "nx serve storefront --verbose",
    "build": "nx run-many --target build --all",
    "lint": "nx run-many --target lint --all",
    "test": "nx run-many --target test --all",
    "db:migrate": "cd apps/backend && medusa db:migrate",
    "db:generate": "cd apps/backend &&  medusa db:generate",
    "db:create": "cd apps/backend &&  medusa db:create",
    "generate:types": "nx run medusa-api:generate-types",
    "db:seed": "cd apps/backend && medusa exec ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@analogjs/router": "^2.0.0",
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "@medusajs/admin-sdk": "^2.12.5",
    "@medusajs/dashboard": "^2.12.5",
    "@medusajs/framework": "^2.10.0",
    "@medusajs/js-sdk": "^2.10.0",
    "@medusajs/medusa": "^2.10.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@spartan-ng/brain": "^0.0.1-alpha.605",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-angular": "^0.474.0",
    "ng-signal-forms": "^1.14.0",
    "ngxtension": "^7.0.2",
    "pg": "^8.17.1",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.4.0",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.0.0",
    "@analogjs/vite-plugin-angular": "^2.0.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@medusajs/medusa-cli": "^1.3.23",
    "@medusajs/types": "^2.10.0",
    "@medusajs/ui-preset": "^2.12.5",
    "@nx/angular": "^22.3.3",
    "@nx/esbuild": "^22.3.3",
    "@nx/eslint-plugin": "^22.3.3",
    "@nx/js": "^22.3.3",
    "@nx/node": "^22.3.3",
    "@nx/playwright": "^22.3.3",
    "@nx/vite": "^22.3.3",
    "@nx/workspace": "^22.0.0",
    "@openapitools/openapi-generator-cli": "^2.27.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.19.7",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "nx": "^22.3.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "overrides": {
    "ng-signal-forms": {
      "@angular/core": "$@angular/core",
      "@angular/forms": "$@angular/forms"
    },
    "lucide-angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "@medusajs/ui-preset": {
      "tailwindcss": "$tailwindcss"
    },
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
