{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @medusajs/medusa-cli build",
        "cwd": "apps/backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @medusajs/medusa-cli dev",
        "cwd": "apps/backend"
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @medusajs/medusa-cli db:migrate",
        "cwd": "apps/backend"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx @medusajs/medusa-cli db:generate",
        "cwd": "apps/backend"
      }
    }
  },
  "tags": []
}
